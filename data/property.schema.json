{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://not-osha-approved.github.io/No-More-Asshole-Neighbors/data/property.schema.json",
  "title": "No More Asshole Neighbors Property",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "location", "listing", "land", "dwelling", "utilities", "restrictions", "affordability", "lifestyle", "qualification", "research", "links"],
  "properties": {
    "id": { "type": "string", "pattern": "^NMAN-[0-9]{3,}$" },
    "name": { "type": "string", "minLength": 1 },
    "nickname": { "type": ["string", "null"] },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["address", "city", "state", "county", "latitude", "longitude", "setting", "coordinateAccuracy"],
      "properties": {
        "address": { "type": "string" },
        "city": { "type": "string", "minLength": 1 },
        "state": { "type": "string", "pattern": "^[A-Z]{2}$" },
        "county": { "type": "string", "minLength": 1 },
        "latitude": { "type": "number", "minimum": -90, "maximum": 90 },
        "longitude": { "type": "number", "minimum": -180, "maximum": 180 },
        "setting": { "enum": ["rural", "semi-rural", "suburban", "urban", "unknown"] },
        "coordinateAccuracy": { "enum": ["parcel", "address", "approximate", "unknown"] }
      }
    },
    "listing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "price", "dateAdded", "dateChecked"],
      "properties": {
        "status": { "enum": ["active", "pending", "sold", "off-market", "unknown"] },
        "price": { "type": ["number", "null"], "minimum": 0 },
        "previousPrice": { "type": ["number", "null"], "minimum": 0 },
        "dateAdded": { "type": "string", "format": "date" },
        "dateChecked": { "type": "string", "format": "date" }
      }
    },
    "land": {
      "type": "object",
      "additionalProperties": false,
      "required": ["acres", "wooded", "roadAccess", "floodRisk"],
      "properties": {
        "acres": { "type": ["number", "null"], "exclusiveMinimum": 0 },
        "wooded": { "enum": ["heavily", "partially", "cleared", "unknown"] },
        "roadAccess": { "enum": ["legal-paved", "legal-unpaved", "uncertain", "landlocked", "unknown"] },
        "floodRisk": { "enum": ["low", "mixed", "high", "unknown"] },
        "wetlands": { "enum": ["none-known", "partial", "substantial", "unknown"] }
      }
    },
    "dwelling": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exists", "type", "condition"],
      "properties": {
        "exists": { "type": "boolean" },
        "type": { "enum": ["house", "mobile-home", "cabin", "condemned-structure", "other", "none", "unknown"] },
        "condition": { "enum": ["move-in", "livable", "repairable", "major-rehab", "condemned", "none", "unknown"] }
      }
    },
    "utilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["overall", "power", "water", "septic"],
      "properties": {
        "overall": { "enum": ["existing", "partial", "none", "unknown"] },
        "power": { "enum": ["connected", "available", "solar-only", "none", "unknown"] },
        "water": { "enum": ["public", "well", "available", "none", "unknown"] },
        "septic": { "enum": ["installed", "sewer", "permitted", "none", "unknown"] }
      }
    },
    "restrictions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hoa", "deedRestrictions", "zoning"],
      "properties": {
        "hoa": { "enum": ["none", "present", "unknown"] },
        "deedRestrictions": { "enum": ["none-known", "present", "unknown"] },
        "zoning": { "type": "string", "minLength": 1 }
      }
    },
    "affordability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fit", "estimatedMonthlyHousingCost", "calculationStatus"],
      "properties": {
        "fit": { "enum": ["comfortable", "tight", "unaffordable", "unknown"] },
        "estimatedMonthlyHousingCost": { "type": ["number", "null"], "minimum": 0 },
        "calculationStatus": { "enum": ["estimated", "verified", "not-calculated"] },
        "notes": { "type": "string" }
      }
    },
    "lifestyle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["visibleNeighbors", "driveway", "gatePotential", "workshopPotential", "solarPotential"],
      "properties": {
        "visibleNeighbors": { "enum": ["none", "few", "several", "many", "unknown"] },
        "driveway": { "enum": ["long", "moderate", "short", "none", "unknown"] },
        "gatePotential": { "enum": ["excellent", "possible", "poor", "unknown"] },
        "workshopPotential": { "enum": ["existing", "excellent", "possible", "poor", "unknown"] },
        "solarPotential": { "enum": ["excellent", "good", "limited", "poor", "unknown"] }
      }
    },
    "qualification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "missedRequirements", "exceptionReason", "exceptionalStrengths", "rejectionReasons"],
      "properties": {
        "status": { "enum": ["match", "exception", "rejected"] },
        "missedRequirements": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["minimum-acreage", "existing-utilities-or-dwelling", "no-hoa", "rural-setting", "affordability"] }
        },
        "exceptionReason": { "type": ["string", "null"] },
        "exceptionalStrengths": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "rejectionReasons": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "research": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stage", "confidence", "confirmed", "unknowns", "notes"],
      "properties": {
        "stage": { "enum": ["discovered", "screened", "researching", "verified", "visited"] },
        "confidence": { "type": "integer", "minimum": 0, "maximum": 100 },
        "confirmed": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "unknowns": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "notes": { "type": "string" }
      }
    },
    "links": {
      "type": "object",
      "additionalProperties": false,
      "required": ["listing", "map"],
      "properties": {
        "listing": { "type": ["string", "null"], "format": "uri" },
        "map": { "type": ["string", "null"], "format": "uri" },
        "countyGis": { "type": ["string", "null"], "format": "uri" }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "restrictions": {
            "properties": { "hoa": { "const": "present" } },
            "required": ["hoa"]
          }
        }
      },
      "then": {
        "properties": {
          "qualification": {
            "properties": {
              "status": { "const": "rejected" },
              "missedRequirements": { "contains": { "const": "no-hoa" } },
              "rejectionReasons": { "minItems": 1 }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "qualification": {
            "properties": { "status": { "const": "match" } },
            "required": ["status"]
          }
        }
      },
      "then": {
        "properties": {
          "land": { "properties": { "acres": { "type": "number", "minimum": 2 } } },
          "restrictions": { "properties": { "hoa": { "const": "none" } } },
          "affordability": { "properties": { "fit": { "const": "comfortable" } } },
          "location": { "properties": { "setting": { "enum": ["rural", "semi-rural"] } } },
          "qualification": {
            "properties": {
              "missedRequirements": { "maxItems": 0 },
              "exceptionReason": { "type": "null" },
              "exceptionalStrengths": { "maxItems": 0 },
              "rejectionReasons": { "maxItems": 0 }
            }
          }
        },
        "anyOf": [
          { "properties": { "dwelling": { "properties": { "exists": { "const": true } } } } },
          { "properties": { "utilities": { "properties": { "overall": { "const": "existing" } } } } }
        ]
      }
    },
    {
      "if": {
        "properties": {
          "qualification": {
            "properties": { "status": { "const": "exception" } },
            "required": ["status"]
          }
        }
      },
      "then": {
        "properties": {
          "restrictions": { "properties": { "hoa": { "enum": ["none", "unknown"] } } },
          "qualification": {
            "properties": {
              "missedRequirements": { "minItems": 1 },
              "exceptionReason": { "type": "string", "minLength": 1 },
              "exceptionalStrengths": { "minItems": 1 },
              "rejectionReasons": { "maxItems": 0 }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "qualification": {
            "properties": { "status": { "const": "rejected" } },
            "required": ["status"]
          }
        }
      },
      "then": {
        "properties": {
          "qualification": {
            "properties": { "rejectionReasons": { "minItems": 1 } }
          }
        }
      }
    }
  ]
}
